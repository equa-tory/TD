{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build All",
      "type": "shell",
      // "command": "C:\\Windows\\Microsoft.NET\\Framework\\v3.5\\MSBuild.exe TokenizerDesktop.sln",
      "command": "taskkill /IM Manager.exe /F ;& taskkill /IM Buttons.exe /F ;& C:\\Windows\\Microsoft.NET\\Framework\\v3.5\\MSBuild.exe ManagerApp\\Manager.csproj ; C:\\Windows\\Microsoft.NET\\Framework\\v3.5\\MSBuild.exe ButtonsApp\\Buttons.csproj",
      // "group": { "kind": "build", },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build Manager App",
      "type": "shell",
      "command": "taskkill /IM Manager.exe /F ;& C:\\Windows\\Microsoft.NET\\Framework\\v3.5\\MSBuild.exe ManagerApp/Manager.csproj",
      // "group": { "kind": "build", },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build Buttons App",
      "type": "shell",
      "command": "taskkill /IM Buttons.exe /F ;& C:\\Windows\\Microsoft.NET\\Framework\\v3.5\\MSBuild.exe ButtonsApp\\Buttons.csproj",
      // "group": { "kind": "build", },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Run Buttons App",
      "type": "shell",
      "command": "${workspaceFolder}\\bin\\Debug\\Buttons.exe",
      "dependsOn": "Build Buttons App",
      "problemMatcher": [],
      "group": { "kind": "build" },
    },
    {
      "label": "Run Manager App",
      "type": "shell",
      "command": "${workspaceFolder}\\bin\\Debug\\Manager.exe",
      "dependsOn": "Build Manager App",
      "problemMatcher": [],
      "group": { "kind": "build", },
    },
    {
      "label": "Run All",
      "type": "shell",
      "command": "${workspaceFolder}\\bin\\Debug\\Manager.exe ;& ${workspaceFolder}\\bin\\Debug\\Buttons.exe",
      "dependsOn": "Build All",
      "problemMatcher": [],
      "group": { "kind": "build", },
    }
  ]
}