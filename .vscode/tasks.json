{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build All",
      "type": "shell",
      "command": "C:\\Windows\\Microsoft.NET\\Framework\\v3.5\\MSBuild.exe TokenizerDesktop.sln",
      "group": { "kind": "build", },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build Manager App",
      "type": "shell",
      "command": "C:\\Windows\\Microsoft.NET\\Framework\\v3.5\\MSBuild.exe ManagerApp/Manager.csproj",
      "group": { "kind": "build", },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build Buttons App",
      "type": "shell",
      "command": "C:\\Windows\\Microsoft.NET\\Framework\\v3.5\\MSBuild.exe ButtonsApp\\Buttons.csproj",
      "group": { "kind": "build", },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Run Buttons App",
      "type": "shell",
      "command": "${workspaceFolder}\\ButtonsApp\\bin\\Debug\\Buttons.exe",
      "dependsOn": "Build Buttons App",
      "problemMatcher": [],
      "group": { "kind": "build", },
    }
  ]
}